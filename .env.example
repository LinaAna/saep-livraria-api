# Copie para .env:  cp .env.example .env

# ── Opção A · Supabase (Postgres na nuvem) — recomendado ──
# No painel do Supabase: botão "Connect" → aba "Connection string" →
# escolha "Session pooler" (funciona em rede IPv4; o "Direct" é IPv6) → copie a URI aqui.
# Ex.: postgresql://postgres.abcdef:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ── Opção B · Postgres local via Docker (padrão do projeto) ──
# Deixe DATABASE_URL vazio e preencha estas com as credenciais do seu Postgres:
DB_HOST=localhost
DB_PORT=5432
DB_USER=livraria
DB_PASSWORD=livraria
DB_NAME=livraria
# DB_SSL=true    # ligue só se o seu Postgres local exigir SSL
